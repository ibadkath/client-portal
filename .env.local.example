# Copy this file to .env.local and you're ready to go -- no other setup needed.
#
# These point at the staging Supabase project. Committing them is intentional,
# not an oversight: NEXT_PUBLIC_* values ship in the browser bundle on every
# page load anyway, so they were never secret -- Row Level Security, not key
# secrecy, is what protects the data behind them. This is what lets a fresh
# clone of this repo work immediately, with no Slack message or Supabase
# project invite required first.
#
# Staging already has the same three seeded accounts as local dev (see
# supabase/seed.sql) -- password `password123` for all:
#   admin@example.com    (admin)
#   client@acme.test     (client, Acme Corp)
#   client@globex.test   (client, Globex Inc)
#
# Do NOT add SUPABASE_SERVICE_ROLE_KEY here. It's a real secret (bypasses RLS
# entirely) and isn't needed to run the app -- see README.md.

NEXT_PUBLIC_SUPABASE_URL=https://jbjajtyejirjwzktsixp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_m9kr4gJYsutxg47ePjWwkQ_JBB3IyoN
